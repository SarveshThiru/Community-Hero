# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Neon Auth (if using Neon Auth instead of Supabase Auth)
# NEON_AUTH_CLIENT_ID=your_neon_client_id
# NEON_AUTH_CLIENT_SECRET=your_neon_client_secret

# MapLibre (OpenStreetMap raster tiles by default; no API key needed)
# NEXT_PUBLIC_MAP_STYLE_URL=your_map_style_url

# AI/ML Services (optional - for TensorFlow.js client-side)
# HUGGINGFACE_API_KEY=your_huggingface_key
# OPENAI_API_KEY=your_openai_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Community Hero"